# Which engine drives hypothesis generation.
#   mock   = no API calls, no key, no cost (canned, varied hypotheses) — DEFAULT
#   claude = real Anthropic Claude API (requires ANTHROPIC_API_KEY)
ENGINE=mock

# Required only when ENGINE=claude
ANTHROPIC_API_KEY=

# Let the Generation/Reflection agents use the server-side web_search tool
# (only applies when ENGINE=claude; may be blocked by network/account policy).
ENABLE_WEB_SEARCH=false

# Max research rounds per run (Generation -> Reflection -> Ranking -> Evolution -> Proximity -> Meta-review).
MAX_ROUNDS=3

# Soft cost guard (claude engine only): abort the run if cumulative tokens exceed this.
TOKEN_BUDGET=2000000

# HTTP port for the local server.
PORT=8787
